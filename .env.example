# ВАЖНО: если токен когда-либо отправлялся в чат, перевыпустите его через BotFather.
TELEGRAM_BOT_TOKEN=

# Для production лучше указать явно. Если оставить пустым, первый /start закрепит владельца.
ADMIN_TELEGRAM_ID=

# Для салона «Кудри» (Улан-Удэ) — Asia/Irkutsk.
TIMEZONE=Asia/Irkutsk
DATABASE_URL=sqlite:///waitlist.db

YCLIENTS_ENABLED=false
YCLIENTS_BASE_URL=https://api.yclients.com/api/v1
YCLIENTS_BEARER_TOKEN=
YCLIENTS_USER_TOKEN=
YCLIENTS_COMPANY_ID=

# Услуга и мастер выбираются в самой заявке. Эти два значения — запасной вариант
# для старых заявок и для случая, когда услуга в заявке не указана.
YCLIENTS_SERVICE_ID=
YCLIENTS_STAFF_ID=

YCLIENTS_CHECK_INTERVAL_MINUTES=15

# Насколько далеко от желаемого времени окно всё ещё интересно клиенту (в часах).
# 0 — уведомлять о любом свободном окне в этот день.
SLOT_TIME_TOLERANCE_HOURS=3
